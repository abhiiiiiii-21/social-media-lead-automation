# ==============================================================================
venv/
**/venv/
.venv/
**/.venv/
env/
**/env/
ENV/
**/ENV/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.coverage
htmlcov/

