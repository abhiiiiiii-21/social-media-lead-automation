storage/media/*
!storage/media/.gitkeep
storage/sessions/*
!storage/sessions/.gitkeep
storage/logs/*
!storage/logs/.gitkeep
storage/exports/*
!storage/exports/.gitkeep
storage/uploads/*
!storage/uploads/.gitkeep

